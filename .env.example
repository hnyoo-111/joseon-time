# Cesium ion 토큰 — 근정전 3D 타일셋(계정 자산) 로드에만 쓰인다.
# World Terrain 은 CesiumJS 내장 토큰으로 받으므로 이 값이 없어도 지형은 나온다.
VITE_CESIUM_ION_TOKEN=

# 3D 모델 소스. 두 값의 조합으로 원본/최적화본을 전환한다.
#
#  ① 스케줄러 원본(raw) — 기본값. 189 서버가 원천에서 직접 받은 gltf 를 그대로 표출.
VITE_ASSET_BASE=https://joseon-time.gaia3d.dev/raw-asset/
VITE_ASSET_FILE=scene.gltf
#
#  ② 최적화 릴리스 — build_release.mjs 산출물이 게시된 뒤 전환.
# VITE_ASSET_BASE=https://joseon-time.gaia3d.dev/asset/
# VITE_ASSET_FILE=scene.glb
#
#  ③ 189 서버에서 앱까지 직접 서빙할 때(동일 출처)는 앞의 도메인을 떼고 /raw-asset/ 만.

# 배경지도 타일. 189 서버가 타일을 서빙하게 되면 그 경로로 바꾼다.
# VITE_TILE_URL=https://joseon-time.gaia3d.dev/tiles/{z}/{x}/{y}.png

# 국사편찬위 한국근대지리정보 오픈API 키 — bake_map1919_tiles.py 가 쓴다
HGIS_API_KEY=

# Supabase — 관리자 페이지(3D 자산 업로드·공개 관리)용 DB/Auth/Storage
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
